# Development only. Generate your own key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-secret
PORT=5000
# AUTO_SEED=false when restoring a database that already contains demo data.
AUTO_SEED=true
# Local HTTP requires false. Set true only behind HTTPS.
SESSION_COOKIE_SECURE=false
